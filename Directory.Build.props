<Project>

  <!-- Settings shared by every .NET project of the solution; a project overrides any of them in its own csproj. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Interop assemblies generated by tools/gen-interop.ps1 (git-ignored). Projects that need engine or game types
         list them as GameInterop items (Directory.Build.targets); they ship in Mjolnir\interop, never next to a mod. -->
    <InteropDir>$(MSBuildThisFileDirectory)build\interop</InteropDir>
    <!-- One version for the platform: Mjolnir.Core, Mjolnir.SDK and the SDK's modules (Mjolnir.SDK.UI…). 0.2.0: the
         UI facade became its own assembly, so mods built against 0.1.0 must be rebuilt. 0.3.0: the modules Player,
         Content, AI, World and Stats, and breaking renames in the UI module, so 0.2.0's mods are rebuilt. 0.4.0: the
         modules Net, Animation, Combat, Camera and Terrain, and a mod is ClientOnly unless it declares otherwise, so
         0.3.0's mods are rebuilt. 0.4.1: a mod may declare the platform range it needs; nothing was taken away, so
         0.4.0's mods keep working. 0.4.2: a fix in the UI
         module only, so 0.4.1's mods keep working too. 0.4.3: UiItemCard added and nothing taken away, so
         0.4.2's mods keep working. 0.4.4: ToolTipOnIcon added, nothing taken away, so 0.4.3's mods keep
         working. 0.4.5: the terrain module's zones, roads, objects and grid, and the player's controls for a mod's
         tool, added, nothing taken away, so 0.4.4's mods keep working. 0.4.6: the build palette, quick slots, object
         marks and previews, obstacles and road lines added, nothing taken away, so 0.4.5's mods keep working. -->
    <MjolnirPlatformVersion>0.4.7</MjolnirPlatformVersion>
  </PropertyGroup>

  <!-- The SDK's public API: Mjolnir.SDK and its modules Mjolnir.SDK.<Facade> (not their tests), the assemblies mods
       compile against. Each ships its XML documentation next to the dll (mod authors' IntelliSense; the compiler checks
       every cref) and declares its public API in PublicAPI.Shipped.txt and PublicAPI.Unshipped.txt next to the csproj
       (Microsoft.CodeAnalysis.PublicApiAnalyzers): a public change that is not declared there is a warning, RS0016
       for an addition and RS0017 for a removal. New API goes into Unshipped; a release moves it to Shipped. -->
  <PropertyGroup>
    <IsMjolnirSdkApi Condition="'$(MSBuildProjectName)' == 'Mjolnir.SDK' or ($(MSBuildProjectName.StartsWith('Mjolnir.SDK.')) and !$(MSBuildProjectName.EndsWith('.Tests')))">true</IsMjolnirSdkApi>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IsMjolnirSdkApi)' == 'true'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 (a public member without a doc comment): left off, since many need none (enum members, Equals and
         operators, the XxxProperty fields next to their documented CLR properties); malformed comments, unknown
         crefs and missing param tags still warn. RS0026 (several overloads with optional parameters): Bind and the
         Command constructors have them on purpose. -->
    <NoWarn>$(NoWarn);CS1591;RS0026</NoWarn>
  </PropertyGroup>
  <!-- The package adds PublicAPI.Shipped.txt and PublicAPI.Unshipped.txt next to the csproj itself (buildTransitive);
       listing them again duplicates them, and its code fix then declares nothing. -->
  <ItemGroup Condition="'$(IsMjolnirSdkApi)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <!-- An interop assembly is referenced, not copied: Mjolnir\interop has it at runtime. Test hosts load the SDK outside
       the game and need the copies (IsTestProject comes from Microsoft.NET.Test.Sdk).
       GameInterop and MjolnirSdk items are names, not files: hidden from the IDE's project tree (Rider and VS showed each
       as a missing file); the references made from them appear under Dependencies. -->
  <ItemDefinitionGroup>
    <GameInterop>
      <Private Condition="'$(IsTestProject)' != 'true'">false</Private>
      <Visible>false</Visible>
    </GameInterop>
    <MjolnirSdk>
      <Visible>false</Visible>
    </MjolnirSdk>
  </ItemDefinitionGroup>

</Project>
