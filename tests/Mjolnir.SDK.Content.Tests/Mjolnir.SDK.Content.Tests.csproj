<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests for the Mjolnir.SDK.Content module that need no game: the module's entry and its public API boundary.
       The localization it connects to the game is the SDK's, tested in Mjolnir.SDK.Tests. Run with
       `dotnet test tests/Mjolnir.SDK.Content.Tests`. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <!-- Both, copied next to the tests: SdkModuleTests looks for the module next to Mjolnir.SDK.dll. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Mjolnir.SDK\Mjolnir.SDK.csproj" />
    <ProjectReference Include="..\..\src\Mjolnir.SDK.Content\Mjolnir.SDK.Content.csproj" />
  </ItemGroup>

  <!-- The interop assemblies the module references, loaded by the test host; no test touches the IL2CPP runtime. -->
  <ItemGroup>
    <GameInterop Include="Il2Cppmscorlib;UnityEngine.CoreModule;Il2CppSystem.Core;SandSailorStudio;Unity.TextMeshPro" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\ApiSurface.cs" Link="Shared\ApiSurface.cs" />
  </ItemGroup>

</Project>
