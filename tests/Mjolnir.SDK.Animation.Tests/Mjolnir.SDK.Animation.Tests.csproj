<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests for the Mjolnir.SDK.Animation module that need no game: its boundary and entry, mods' animations and masks,
       and the messages between players. The model it connects to the game is tested in Mjolnir.SDK.Tests (AnimationTests).
       Run with `dotnet test tests/Mjolnir.SDK.Animation.Tests`. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <!-- Both, copied next to the tests: SdkModuleTests looks for the module next to Mjolnir.SDK.dll. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Mjolnir.SDK\Mjolnir.SDK.csproj" />
    <ProjectReference Include="..\..\src\Mjolnir.SDK.Animation\Mjolnir.SDK.Animation.csproj" />
  </ItemGroup>

  <!-- The interop assemblies the module references, loaded by the test host; no test touches the IL2CPP runtime. -->
  <ItemGroup>
    <GameInterop Include="Il2Cppmscorlib;UnityEngine.CoreModule;UnityEngine.AnimationModule;UnityEngine.AssetBundleModule" />
    <GameInterop Include="Assembly-CSharp;SandSailorStudio;Fusion.Runtime;Fusion.Common" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\ApiSurface.cs" Link="Shared\ApiSurface.cs" />
  </ItemGroup>

</Project>
