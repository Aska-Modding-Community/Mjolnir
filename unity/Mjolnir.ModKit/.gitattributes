# The kit's files, as git should treat them. The project is serialized as text, so its assets diff and merge as
# text; Unity writes them with LF on every platform, so they are checked out with LF and never flap between endings.
* text=auto

*.meta           text eol=lf
*.asset          text eol=lf
*.prefab         text eol=lf
*.unity          text eol=lf
*.mat            text eol=lf
*.mask           text eol=lf
*.anim           text eol=lf
*.controller     text eol=lf
*.physicMaterial text eol=lf
*.shader         text eol=lf
*.shadergraph    text eol=lf
*.json           text eol=lf

# What git must never convert or try to merge.
*.png  binary
*.jpg  binary
*.jpeg binary
*.tga  binary
*.psd  binary
*.exr  binary
*.hdr  binary
*.dds  binary
*.fbx  binary
*.blend binary
*.wav  binary
*.ogg  binary
*.mp3  binary
*.ttf  binary
*.otf  binary
*.dll  binary
*.pdb  binary
*.unitypackage binary
