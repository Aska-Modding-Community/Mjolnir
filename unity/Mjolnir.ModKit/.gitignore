# What Unity makes again by itself, and the bundles the kit builds (tools/build-bundles.ps1 copies them to the mods).
/Library/
/Temp/
/Logs/
/UserSettings/
/MemoryCaptures/
/Recordings/
/Build/
/obj/
*.csproj
*.sln
*.slnx
*.unitypackage
sysinfo.txt
# A package someone put in Packages/ for their own work, and the lock file Unity then rewrites: the project's own
# dependencies are pinned in manifest.json, and each computer resolves the rest for itself.
/Packages/*/
/Packages/packages-lock.json
# What an editor or an IDE leaves beside the project.
/.vs/
/.idea/
/.vsconfig
.DS_Store
# The game's skeletons, imported from the player's own game (Mjolnir > Import Rigs): the game's, not ours.
/Assets/Mjolnir/Rigs/
/Assets/Mjolnir/Rigs.meta
# Clips the bundle build takes out of mods' model files (BundleBuilder.ClipsFolder): made again by every build.
/Assets/Mjolnir/Clips/
/Assets/Mjolnir/Clips.meta
# The preview stage (PreviewStage): made again by the kit when missing.
/Assets/Mjolnir/Preview/
/Assets/Mjolnir/Preview.meta
# The game's own clips (Mjolnir > Rigs > Import from the Game, when the game wrote them): the game's, not ours.
/Assets/Mjolnir/GameClips/
/Assets/Mjolnir/GameClips.meta
